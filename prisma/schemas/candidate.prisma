model candidate {
  uid                               String                 @id @unique @default(uuid()) @db.Uuid
  created                           DateTime               @default(now())
  updated                           DateTime               @updatedAt
  // Personal Information
  first_name                        String?
  last_name                         String?
  email                             String?
  phone                             String?
  country_calling_code              String?
  contact_info_last_updated         DateTime?
  rocketreach_profile_id            String?
  // Location
  current_location_city             String?
  current_location_country_code     String?
  current_location_postal_code      String?
  open_to_relocation                Boolean?
  open_to_remote_work               Boolean?
  current_work_authorization_status String?
  // Experience
  experience_years                  Int?
  experience_roles                  String[]
  current_title                     String?
  current_company                   String?
  current_salary                    Float?
  current_salary_currency           String?
  current_role_start_date           DateTime?
  // Skills
  skills                            String[]
  languages                         String[]
  diversity                         String[]
  // other
  summary                           String?
  image_url                         String?
  enriched_at                       DateTime? // set once a deep candidate search has run, so it isn't repeated
  experience                        candidate_experience[]
  // Relationships
  role_results                      role_result[]
  education                         candidate_education[]
  sources                           candidate_source[]
}
