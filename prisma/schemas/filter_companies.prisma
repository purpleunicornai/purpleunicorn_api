enum CompanyFilterType {
  CURRENT
  PAST
  EXCLUDED
}

model filter_companies {
  uid             String            @id @unique @default(uuid()) @db.Uuid
  created         DateTime          @default(now())
  updated         DateTime          @updatedAt
  role_filters_id String            @db.Uuid
  role_filters    role_filters      @relation(fields: [role_filters_id], references: [uid])
  type            CompanyFilterType @default(CURRENT)
  company_names   String[]
  start_date      DateTime?
  end_date        DateTime?

  @@index([role_filters_id])
}
