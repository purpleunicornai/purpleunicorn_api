enum OrganizationCreditsType {
  AI_TOKENS
  ROCKET_REACH
  EMAILS
  SMS
  // The one balance deep research (and its sources, such as RocketReach)
  // is charged to.
  CREDITS
}

// Why a ledger row exists. Grants, refunds, purchases and positive
// adjustments add credits; research charges, expiry and negative
// adjustments take them away.
enum OrganizationCreditEntryKind {
  MONTHLY_GRANT
  // The unused part of the previous period's grant, written when the next
  // period's grant is (the allowance doesn't roll over; purchases do).
  ALLOWANCE_EXPIRY
  RESEARCH
  // Buying a candidate's contact details (a RocketReach lookup).
  CONTACT_LOOKUP
  REFUND
  PURCHASE
  ADJUSTMENT
}

// An append-only credit ledger: one row per transaction, and an org's
// balance is the sum of its rows' amounts, so every change is auditable.
model organization_credits {
  uid             String                      @id @unique @default(uuid()) @db.Uuid
  created         DateTime                    @default(now()) @db.Timestamptz(3)
  updated         DateTime                    @updatedAt @db.Timestamptz(3)
  organization_id String
  type            OrganizationCreditsType
  // Signed: positive adds credits, negative spends them.
  amount          Int
  kind            OrganizationCreditEntryKind @default(ADJUSTMENT)
  // The allowance period ("2026-11", UTC) the row counts against.
  period          String?
  // Clerk user who caused the row; null for system rows (grants, expiry).
  user_id         String?
  // What it relates to. Plain ids rather than relations, so deleting a role
  // never deletes its spend from the audit trail.
  role_id         String?                     @db.Uuid
  role_result_id  String?                     @db.Uuid
  reason          String?
  // Per-source costs for a research charge, and the like.
  metadata        Json?
  // Makes a grant, expiry or refund safe to write twice: the second insert
  // collides and is skipped (e.g. "grant:<org>:2026-11").
  idempotency_key String?                     @unique
  logs            organization_log[]          @relation("CreditsLogs")

  // A credits balance is computed by summing rows per org per credit type,
  // so this composite covers that directly and plain organization_id
  // lookups too.
  @@index([organization_id, type])
  @@index([organization_id, period])
  @@index([organization_id, created])
}
