enum OrganizationCreditsType {
  AI_TOKENS
  ROCKET_REACH
  EMAILS
  SMS
}

model organization_credits {
  uid             String                  @id @unique @default(uuid()) @db.Uuid
  created         DateTime                @default(now())
  updated         DateTime                @updatedAt
  organization_id String
  type            OrganizationCreditsType
  amount          Int
  logs            organization_log[]      @relation("CreditsLogs")

  // A credits balance is computed by summing rows per org per credit type,
  // so this composite covers that directly and plain organization_id
  // lookups too.
  @@index([organization_id, type])
}
