enum RoleFilterPriority {
  ESSENTIAL
  OPTIONAL
}

model role_filters {
  uid              String                        @id @unique @default(uuid()) @db.Uuid
  created          DateTime                      @default(now())
  updated          DateTime                      @updatedAt
  role_id          String                        @db.Uuid
  role             roles                         @relation(fields: [role_id], references: [uid], onDelete: Cascade)
  category         String
  value            String?
  list_value       String[]
  priority         RoleFilterPriority            @default(OPTIONAL)
  non_negotiable   Boolean                       @default(false)
  children         role_filter_child[]
  archived         Boolean                       @default(false)
  archived_at      DateTime?
  search_run_date  DateTime?
  metadata         Json?                         @db.JsonB
  role_results     role_result[]
  score_breakdowns role_result_score_breakdown[]
  logs             organization_log[]            @relation("RoleFilterLogs")

  // Every filter lookup in the app is scoped to a role and the "current"
  // (non-archived) one, e.g. `where: { role_id, archived: false }` — this
  // composite index covers that directly and plain role_id lookups too.
  @@index([role_id, archived])
}
