enum InstitutionType {
  HIGH_SCHOOL
  COLLEGE
  UNIVERSITY
  COURSE
  OTHER
}

model candidate_education {
  uid                  String          @id @unique @default(uuid()) @db.Uuid
  created              DateTime        @default(now()) @db.Timestamptz(3)
  updated              DateTime        @updatedAt @db.Timestamptz(3)
  candidate_id         String          @db.Uuid
  candidate            candidate       @relation(fields: [candidate_id], references: [uid], onDelete: Cascade)
  institution_name     String
  institution_type     InstitutionType
  institution_location String?
  degree               String?
  field_of_study       String?
  start_date           DateTime        @db.Timestamptz(3)
  end_date             DateTime?       @db.Timestamptz(3)
  summary              String?
  additional_info      String?

  @@index([candidate_id])
}
