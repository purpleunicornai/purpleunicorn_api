enum OrganizationLogType {
  CREATED
  UPDATED
  // Projects
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  PROJECT_USERS_ADDED
  PROJECT_USERS_REMOVED
  // Roles
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_FILTERS_CREATED
  ROLE_FILTERS_UPDATED
  ROLE_SEARCH
  // Candidate
  CANDIDATE_DEEP_SEARCH
  CANDIDATE_ROCKET_REACH_SEARCH
  CANDIDATE_SHORTLISTED
  CANDIDATE_UNSHORTLISTED
  // Subscription
  SUBSCRIPTION_PURCHASED
  SUBSCRIPTION_RENUED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  // Purhcases
  TOKENS_PURCHASED
  TOKENS_USED
}

model organization_log {
  uid             String                     @id @unique @default(uuid()) @db.Uuid
  created         DateTime                   @default(now())
  updated         DateTime                   @updatedAt
  user_id         String?
  organization_id String
  type            OrganizationLogType
  message         String?
  tokens_used     Int?
  project_id      String?                    @db.Uuid
  project         projects?                  @relation("ProjectLogs", fields: [project_id], references: [uid], onDelete: Cascade)
  role_id         String?                    @db.Uuid
  role            roles?                     @relation("RoleLogs", fields: [role_id], references: [uid], onDelete: Cascade)
  role_filter_id  String?                    @db.Uuid
  role_filter     role_filters?              @relation("RoleFilterLogs", fields: [role_filter_id], references: [uid], onDelete: Cascade)
  role_result_id  String?                    @db.Uuid
  role_result     role_result?               @relation("RoleResultLogs", fields: [role_result_id], references: [uid], onDelete: Cascade)
  subscription_id String?                    @db.Uuid
  subscription    organization_subscription? @relation("SubscriptionLogs", fields: [subscription_id], references: [uid], onDelete: Cascade)
  credits_id      String?                    @db.Uuid
  credits         organization_credits?      @relation("CreditsLogs", fields: [credits_id], references: [uid], onDelete: Cascade)
  candidate_id    String?                    @db.Uuid
  candidate       candidate?                 @relation("CandidateLogs", fields: [candidate_id], references: [uid], onDelete: Cascade)

  // organization_id is a Clerk org id, not a local FK — every log lookup is
  // scoped to it, most often ordered by recency, so it's indexed both alone
  // and paired with created for "recent activity for this org" queries.
  @@index([organization_id])
  @@index([organization_id, created])
  @@index([project_id])
  @@index([role_id])
  @@index([role_filter_id])
  @@index([role_result_id])
  @@index([subscription_id])
  @@index([credits_id])
}
