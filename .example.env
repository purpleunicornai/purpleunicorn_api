PORT=number
CLERK_SECRET_KEY=string
SERPAPI_API_KEY=string

# Web search backend for role searches: google | serper | serpapi | vertex (default google).
# Google's Custom Search JSON API shuts down on 1 Jan 2027. Only the selected
# backend's key is required. See src/services/google-search/README.md.
SEARCH_PROVIDER=google
SERPER_API_KEY=
SERPAPI_KEY=

# SEARCH_PROVIDER=vertex: Vertex AI Search app (engine) over a website data store.
# Auth: VERTEX_SERVICE_ACCOUNT is the base64 of the service-account JSON key, the
# same as yuv-api's FIREBASE_SERVICE_ACCOUNT (`base64 -i key.json | tr -d '\n'`).
# The account needs roles/discoveryengine.viewer. VERTEX_API_KEY instead uses
# searchLite, which only works with public website data stores.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_ENGINE_ID=
VERTEX_SERVING_CONFIG_ID=default_search
VERTEX_SERVICE_ACCOUNT=
# VERTEX_API_KEY=
