PORT=number
CLERK_SECRET_KEY=string
SERPAPI_API_KEY=string

# Web search backend for role searches: google | serper | serpapi (default google).
# Google's Custom Search JSON API shuts down on 1 Jan 2027. Only the selected
# backend's key is required. See src/services/google-search/README.md.
SEARCH_PROVIDER=google
SERPER_API_KEY=
SERPAPI_KEY=
