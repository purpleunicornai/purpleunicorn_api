PORT=number
CLERK_SECRET_KEY=string
DATABASE_URL=string
REDIS_URL=string
GEMINI_API_KEY=string
ROCKET_REACH_API_KEY=string
# Days a RocketReach lookup is reused for the same candidate (0 = off)
ROCKETREACH_CACHE_TTL_DAYS=30
# Optional reasoning providers (orgs can pick their models when set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Research credits (optional; defaults shown)
CREDITS_MONTHLY_ALLOWANCE=50
CREDITS_COST_DEEP_RESEARCH=1
# Comma-separated Clerk user ids allowed to adjust credits (staff only)
CREDITS_ADMIN_USER_IDS=
GITHUB_TOKEN=

# Vertex AI Search app (engine) over a website data store of LinkedIn profiles.
# Auth: VERTEX_SERVICE_ACCOUNT is the base64 of the service-account JSON key, the
# same as yuv-api's FIREBASE_SERVICE_ACCOUNT (`base64 -i key.json | tr -d '\n'`).
# The account needs roles/discoveryengine.viewer. VERTEX_API_KEY instead uses
# searchLite, which only works with public website data stores.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_ENGINE_ID=
VERTEX_SERVING_CONFIG_ID=default_search
VERTEX_SERVICE_ACCOUNT=
# VERTEX_API_KEY=

# Optional: pages a background role search loads per run before pausing (default 5).
ROLE_SEARCH_PAGES_PER_RUN=5
